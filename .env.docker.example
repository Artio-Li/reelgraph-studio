# 复制为 .env 后再启动。以下三个值必须修改。
MUSE2API_KEY=m2a_replace_with_a_long_random_key
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-admin-password

ADMIN_EMAIL=admin@reelgraph.local
REELGRAPH_PORT=8787
PUBLIC_BASE=
MUSE2API_PUBLIC_BASE=

ALLOW_REGISTER=0
SIGNUP_CREDITS=100
JWT_DAYS=14

MUSE2API_CONCURRENCY=2
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=900
MUSE2API_CHAT_TIMEOUT=300
