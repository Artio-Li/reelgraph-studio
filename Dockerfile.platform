FROM node:24-bookworm-slim AS web-build

WORKDIR /build/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN NODE_OPTIONS=--max-old-space-size=384 npm run build

FROM node:24-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY server/package.json server/package-lock.json ./server/
RUN cd server && npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

COPY server/ ./server/
COPY --from=web-build /build/web/dist ./web/dist
COPY docker-entrypoint.sh /usr/local/bin/museapi-video-entrypoint
RUN chmod 0755 /usr/local/bin/museapi-video-entrypoint

WORKDIR /app/server
EXPOSE 8787

ENTRYPOINT ["/usr/local/bin/museapi-video-entrypoint"]
